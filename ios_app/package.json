    "expo": "~54.0.37",
    "expo-background-fetch": "~14.0.9",
    "expo-blur": "~15.0.0",
    "expo-cellular": "~8.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.0",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
