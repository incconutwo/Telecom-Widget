{
  "expo": {
    "name": "Telecom Widget",
    "slug": "telecom-widget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0F13"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.telecom.widget",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.telecom.widget"
        ]
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cfdd7a35-7573-4e53-9e79-2d302c2e76aa",
      "channel": "production",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-secure-store",
      "expo-updates",
      "./plugins/withTelecomWidgets",
      "expo-local-authentication",
      "expo-notifications",
      "expo-quick-actions",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-localization"
    ],
    "scheme": "telecomwidget",
    "extra": {
      "eas": {
        "projectId": "cfdd7a35-7573-4e53-9e79-2d302c2e76aa"
      }
    }
  }
}
